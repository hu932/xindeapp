<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗面板：与 Compose 主题一致，深色表面 + 青绿细描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F51A202A"
        android:centerColor="#F5151A21"
        android:endColor="#F50E1116"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#4022C1A4" />
</shape>
